+
+// releaseInFlight drops the in-flight charge for a backlog handoff that
+// handleEvents has now consumed. Called exactly once per event produced by
+// processBacklog, after the message has been handled (and possibly re-admitted to
+// the backlog under its own charge).
+func (c *core) releaseInFlight(src common.Address, size int) {
+	c.backlogsMu.Lock()
+	defer c.backlogsMu.Unlock()
+
+	c.backlogsInFlightTotal -= size
+	if c.backlogsInFlightTotal < 0 {
+		c.backlogsInFlightTotal = 0
+	}
+	if c.backlogsInFlightBySrc == nil {
+		return
+	}
+	if remaining := c.backlogsInFlightBySrc[src] - size; remaining > 0 {
+		c.backlogsInFlightBySrc[src] = remaining
+	} else {
+		delete(c.backlogsInFlightBySrc, src)
+	}
+}
